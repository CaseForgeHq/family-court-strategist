{
  "name": "family-court-strategist-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local case workspace with document intake and optional user-selected AI analysis.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.familycourtstrategist.app",
    "productName": "Case Forge",
    "files": ["main.cjs", "preload.cjs"],
    "extraResources": [
      { "from": "../app", "to": "app", "filter": ["server.js", "package.json", "lib/**", "public/**", "node_modules/pdfjs-dist/**", "node_modules/@napi-rs/**"] },
      { "from": "../sample-case", "to": "sample-case" }
    ],
    "mac": { "category": "public.app-category.productivity", "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
